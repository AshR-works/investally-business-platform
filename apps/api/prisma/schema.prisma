// Schéma CRM — S2 : Core (iam, audit, docs) + tranche S1 (bd.Company).
// Un schéma PostgreSQL par contexte. Aucune clé étrangère entre contextes : les références
// inter-contextes sont de simples colonnes UUID (ARCHITECTURE.md). Les clés étrangères restent
// possibles à l'intérieur d'un même contexte.
//
// Hors du champ de Prisma (SQL dans les migrations) : index uniques partiels (soft delete),
// partitionnement mensuel et déclencheurs de l'audit, contraintes CHECK.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["bd", "audit", "iam", "docs", "training", "hr"]
}

// ───────────────────────────── bd (tranche S1) ─────────────────────────────

enum CompanyStatus {
  TARGET
  CONTACTED
  QUALIFIED
  CLIENT
  ARCHIVED

  @@schema("bd")
}

model Company {
  id        String        @id @db.Uuid
  name      String        @db.VarChar(200)
  /// Nom normalisé (minuscules) : unicité parmi les entreprises non supprimées (index partiel en SQL).
  nameKey   String        @map("name_key") @db.VarChar(200)
  status    CompanyStatus @default(TARGET)
  /// Propriétaire (référence inter-contextes vers iam.users, SANS clé étrangère) : détermine la portée des droits.
  ownerUserId String?     @map("owner_user_id") @db.Uuid
  sector    String?       @db.VarChar(100)
  country   String?       @db.VarChar(100)
  email     String?       @db.VarChar(200)
  phone     String?       @db.VarChar(40)
  /// Verrou optimiste.
  version   Int           @default(1)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?     @map("deleted_at") @db.Timestamptz(6)
  facilitation CompanyFacilitation?
  contacts  Contact[]
  offers    Offer[]
  appointments Appointment[]
  opportunities Opportunity[]
  approvals    Approval[]
  ambassadors  Ambassador[]
  payouts      CommissionPayout[]

  @@index([status])
  @@index([ownerUserId])
  @@map("companies")
  @@schema("bd")
}

enum ContactRole {
  FINANCE_DIRECTOR
  DECISION_MAKER
  OTHER

  @@schema("bd")
}

/// Contact : interlocuteur d'une entreprise (DAF, décideur…). Sa visibilité suit celle de son entreprise.
model Contact {
  id        String      @id @db.Uuid
  companyId String      @map("company_id") @db.Uuid
  lastName  String      @map("last_name") @db.VarChar(100)
  firstName String      @map("first_name") @db.VarChar(100)
  /// Nom normalisé (minuscules) pour la détection de doublons.
  nameKey   String      @map("name_key") @db.VarChar(210)
  role      ContactRole @default(OTHER)
  email     String?     @db.VarChar(200)
  emailKey  String?     @map("email_key") @db.VarChar(200)
  phone     String?     @db.VarChar(40)
  version   Int         @default(1)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?   @map("deleted_at") @db.Timestamptz(6)
  company   Company     @relation(fields: [companyId], references: [id])
  appointments Appointment[]

  @@index([companyId])
  @@index([companyId, nameKey])
  @@index([companyId, emailKey])
  @@map("contacts")
  @@schema("bd")
}

enum OfferStatus {
  DRAFT
  SUBMITTED
  RECEIPT_RECEIVED
  ACCEPTED
  REFUSED
  WITHDRAWN

  @@schema("bd")
}

/// Offre faite à une entreprise. Sa visibilité suit celle de l'entreprise ; jamais supprimée (on la retire, avec un motif).
model Offer {
  id              String      @id @db.Uuid
  /// Référence lisible « OFF-2026-0001 » (compteur par année).
  reference       String      @unique @db.VarChar(20)
  companyId       String      @map("company_id") @db.Uuid
  subject         String      @db.VarChar(200)
  amount          Decimal     @db.Decimal(14, 2)
  currency        String      @db.Char(3)
  status          OfferStatus @default(DRAFT)
  note            String?     @db.VarChar(1000)
  submittedAt     DateTime?   @map("submitted_at") @db.Timestamptz(6)
  decidedAt       DateTime?   @map("decided_at") @db.Timestamptz(6)
  withdrawnReason String?     @map("withdrawn_reason") @db.VarChar(500)
  version         Int         @default(1)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  company         Company     @relation(fields: [companyId], references: [id])
  receipts        Receipt[]
  followups       Followup[]
  appointments    Appointment[]

  @@index([companyId])
  @@index([status])
  @@map("offers")
  @@schema("bd")
}

enum ReceiptStatus {
  VALID
  CANCELLED

  @@schema("bd")
}

/// Décharge signée d'une offre déposée. Une offre n'a qu'UNE décharge valide (index unique partiel posé en SQL, que Prisma ne sait pas décrire).
model Receipt {
  id              String        @id @db.Uuid
  offerId         String        @map("offer_id") @db.Uuid
  receivedOn      DateTime      @map("received_on") @db.Date
  receivedBy      String        @map("received_by") @db.VarChar(150)
  status          ReceiptStatus @default(VALID)
  cancelledReason String?       @map("cancelled_reason") @db.VarChar(500)
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  version         Int           @default(1)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  offer           Offer         @relation(fields: [offerId], references: [id])

  @@index([offerId])
  @@map("receipts")
  @@schema("bd")
}

enum FollowupChannel {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  OTHER

  @@schema("bd")
}

enum FollowupStatus {
  PLANNED
  DONE
  CANCELLED

  @@schema("bd")
}

/// Relance d'une offre en cours : à faire à une échéance, par un canal ; terminée (avec son résultat) ou annulée (avec son motif).
model Followup {
  id         String         @id @db.Uuid
  offerId    String         @map("offer_id") @db.Uuid
  dueOn      DateTime       @map("due_on") @db.Date
  channel    FollowupChannel
  note       String?        @db.VarChar(500)
  status     FollowupStatus @default(PLANNED)
  /// Résultat de la relance (terminée) ou motif d'annulation (annulée) ; absent tant qu'elle est à faire.
  resultNote String?        @map("result_note") @db.VarChar(1000)
  closedAt   DateTime?      @map("closed_at") @db.Timestamptz(6)
  version    Int            @default(1)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  offer      Offer          @relation(fields: [offerId], references: [id])

  @@index([offerId])
  @@map("followups")
  @@schema("bd")
}

/// Compteur des références d'offres, une ligne par année (incrémenté dans la transaction de création).
model OfferCounter {
  year Int @id
  last Int

  @@map("offer_counters")
  @@schema("bd")
}

enum ContactMethod {
  WHATSAPP_MESSAGE
  PHONE_CALL
  EMAIL
  MEETING
  OTHER

  @@schema("bd")
}

enum CommissionType {
  FIXED
  PERCENT

  @@schema("bd")
}

/// Facilitateur : personne qui met en relation avec une entreprise (peut en être un employé). Réutilisable.
model Facilitator {
  id          String    @id @db.Uuid
  lastName    String    @map("last_name") @db.VarChar(100)
  firstName   String    @map("first_name") @db.VarChar(100)
  phone       String    @db.VarChar(40)
  comment     String?   @db.VarChar(2000)
  /// Créateur (référence inter-contextes, SANS clé étrangère) : détermine la portée des droits.
  ownerUserId String    @map("owner_user_id") @db.Uuid
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  facilitations CompanyFacilitation[]
  payouts       CommissionPayout[]

  @@index([ownerUserId])
  @@map("facilitators")
  @@schema("bd")
}

/// Lien entreprise ↔ facilitateur : méthode de contact, appartenance à l'entreprise, commission (cohérence en SQL).
model CompanyFacilitation {
  companyId          String          @id @map("company_id") @db.Uuid
  facilitatorId      String          @map("facilitator_id") @db.Uuid
  contactMethod      ContactMethod   @map("contact_method")
  isCompanyEmployee  Boolean         @default(false) @map("is_company_employee")
  commissionType     CommissionType? @map("commission_type")
  commissionValue    Decimal?        @map("commission_value") @db.Decimal(12, 2)
  commissionCurrency String?         @map("commission_currency") @db.Char(3)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  company            Company         @relation(fields: [companyId], references: [id])
  facilitator        Facilitator     @relation(fields: [facilitatorId], references: [id])

  @@index([facilitatorId])
  @@map("company_facilitations")
  @@schema("bd")
}

// ───────────────────────────── audit ─────────────────────────────

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  DOWNLOAD
  EXPORT
  LOGIN
  LOGOUT
  LOGIN_FAILED
  ACCESS_DENIED
  PASSWORD_CHANGE
  MFA_CHANGE
  ROLE_CHANGE
  SESSION_REVOKE
  PASSWORD_RESET

  @@schema("audit")
}

/// Journal append-only, partitionné par mois (SQL). Jamais de UPDATE ni DELETE (déclencheur SQL).
/// La clé primaire inclut createdAt : exigence du partitionnement PostgreSQL.
model AuditLog {
  id         String      @db.Uuid
  userId     String?     @map("user_id") @db.Uuid
  sessionId  String?     @map("session_id") @db.Uuid
  module     String      @db.VarChar(100)
  entityType String      @map("entity_type") @db.VarChar(100)
  entityId   String      @map("entity_id") @db.VarChar(100)
  action     AuditAction
  oldValue   Json?       @map("old_value")
  newValue   Json?       @map("new_value")
  ipAddress  String      @map("ip_address") @db.VarChar(64)
  device     String      @db.VarChar(300)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([id, createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
  @@schema("audit")
}

// ───────────────────────────── iam ─────────────────────────────

enum UserStatus {
  PENDING
  ACTIVE
  LOCKED
  DISABLED

  @@schema("iam")
}

enum RoleScope {
  OWN
  TEAM
  ALL

  @@schema("iam")
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@schema("iam")
}

enum OtpPurpose {
  RECOVERY
  STEP_UP
  EMAIL_VERIFICATION

  @@schema("iam")
}

enum LoginOutcome {
  SUCCESS
  BAD_CREDENTIALS
  LOCKED
  MFA_FAILED
  RATE_LIMITED

  @@schema("iam")
}

model User {
  id                String     @id @db.Uuid
  email             String     @db.VarChar(254)
  /// E-mail normalisé (minuscules) : unicité parmi les comptes non supprimés (index partiel en SQL).
  emailKey          String     @map("email_key") @db.VarChar(254)
  displayName       String     @map("display_name") @db.VarChar(200)
  status            UserStatus @default(PENDING)
  /// Hash argon2id. Jamais journalisé (masqué dans l'audit).
  passwordHash      String?    @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(6)
  mfaEnabled        Boolean    @default(false) @map("mfa_enabled")
  /// Secret TOTP chiffré (AES-256-GCM) ; la clé est hors base.
  mfaSecretEnc      String?    @map("mfa_secret_enc")
  /// Dernier pas TOTP accepté : un code ne sert qu'une fois (anti-rejeu).
  mfaLastUsedStep   BigInt?    @map("mfa_last_used_step")
  /// Responsable hiérarchique : définit la portée TEAM.
  managerId         String?    @map("manager_id") @db.Uuid
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  version           Int        @default(1)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz(6)

  manager         User?              @relation("Hierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  reports         User[]             @relation("Hierarchy")
  roles           UserRole[]
  sessions        UserSession[]
  passwordHistory PasswordHistory[]
  recoveryCodes   MfaRecoveryCode[]
  otps            OneTimePassword[]
  invitations     UserInvitation[]

  @@index([managerId])
  @@index([status])
  @@map("users")
  @@schema("iam")
}

model Role {
  id          String   @id @db.Uuid
  code        String   @unique @db.VarChar(50)
  label       String   @db.VarChar(100)
  description String   @db.VarChar(500)
  mfaRequired Boolean  @default(false) @map("mfa_required")
  /// Rôle livré par le système : non supprimable.
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
  @@schema("iam")
}

model Permission {
  id          String   @id @db.Uuid
  /// `module.ressource.action`
  code        String   @unique @db.VarChar(100)
  module      String   @db.VarChar(50)
  resource    String   @db.VarChar(50)
  action      String   @db.VarChar(50)
  description String   @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
  @@schema("iam")
}

model RolePermission {
  roleId       String    @map("role_id") @db.Uuid
  permissionId String    @map("permission_id") @db.Uuid
  scope        RoleScope

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
  @@schema("iam")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
  @@schema("iam")
}

model UserSession {
  id                String    @id @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  ipAddress         String    @map("ip_address") @db.VarChar(64)
  device            String    @db.VarChar(300)
  browser           String?   @db.VarChar(100)
  os                String?   @db.VarChar(100)
  riskLevel         RiskLevel @default(LOW) @map("risk_level")
  mfaVerified       Boolean   @default(false) @map("mfa_verified")
  /// Dernière vérification MFA de la session : sert au step-up.
  mfaVerifiedAt     DateTime? @map("mfa_verified_at") @db.Timestamptz(6)
  loggedInAt        DateTime  @default(now()) @map("logged_in_at") @db.Timestamptz(6)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  /// Expiration sur inactivité.
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Expiration absolue, quelle que soit l'activité.
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  loggedOutAt       DateTime? @map("logged_out_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason     String?   @map("revoked_reason") @db.VarChar(200)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, loggedInAt])
  @@index([expiresAt])
  @@map("user_sessions")
  @@schema("iam")
}

model RefreshToken {
  id           String    @id @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  /// Famille de rotation : la réutilisation d'un jeton déjà consommé révoque toute la famille.
  familyId     String    @map("family_id") @db.Uuid
  /// SHA-256 du jeton opaque ; le jeton lui-même n'est jamais stocké.
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  issuedAt     DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
  @@schema("iam")
}

model PasswordHistory {
  id           String   @id @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("password_history")
  @@schema("iam")
}

model MfaRecoveryCode {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.VarChar(255)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
  @@schema("iam")
}

model OneTimePassword {
  id         String     @id @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  purpose    OtpPurpose
  codeHash   String     @map("code_hash") @db.VarChar(255)
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("one_time_passwords")
  @@schema("iam")
}

/// Invitation à activer un compte : le mot de passe est choisi par l'utilisateur via un lien à usage unique.
model UserInvitation {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 du jeton ; le jeton lui-même n'est jamais stocké.
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  /// INVITATION (activation d'un compte en attente) ou PASSWORD_RESET (réinitialisation par un administrateur).
  purpose   String    @default("INVITATION") @db.VarChar(20)
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_invitations")
  @@schema("iam")
}

/// Tentatives de connexion (y compris pour des e-mails inconnus : pas de clé étrangère).
model LoginAttempt {
  id        String       @id @db.Uuid
  emailKey  String       @map("email_key") @db.VarChar(254)
  userId    String?      @map("user_id") @db.Uuid
  ipAddress String       @map("ip_address") @db.VarChar(64)
  outcome   LoginOutcome
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([emailKey, createdAt])
  @@index([ipAddress, createdAt])
  @@map("login_attempts")
  @@schema("iam")
}

// ───────────────────────────── docs ─────────────────────────────

enum DocumentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  DELETED

  @@schema("docs")
}

/// Résultat de l'analyse antivirus d'une version (l'analyse n'est livrée qu'en S7 : PENDING jusque-là).
enum ScanStatus {
  PENDING
  CLEAN
  INFECTED

  @@schema("docs")
}

/// Un document appartient à un objet d'un autre contexte, référencé par type + identifiant (sans FK).
/// L'historique d'accès (consultation, téléchargement, export…) est lu dans audit.audit_logs.
model Document {
  id                   String         @id @db.Uuid
  ownerType            String         @map("owner_type") @db.VarChar(50)
  ownerId              String         @map("owner_id") @db.Uuid
  title                String         @db.VarChar(300)
  category             String?        @db.VarChar(100)
  status               DocumentStatus @default(DRAFT)
  currentVersionNumber Int            @default(0) @map("current_version_number")
  createdBy            String         @map("created_by") @db.Uuid
  /// Verrou optimiste.
  version              Int            @default(1)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?      @map("deleted_at") @db.Timestamptz(6)
  deletedBy            String?        @map("deleted_by") @db.Uuid

  versions DocumentVersion[]

  @@index([ownerType, ownerId])
  @@index([status])
  @@map("documents")
  @@schema("docs")
}

model DocumentVersion {
  id            String   @id @db.Uuid
  documentId    String   @map("document_id") @db.Uuid
  versionNumber Int      @map("version_number")
  /// Clé d'objet aléatoire côté stockage (jamais le nom fourni par l'utilisateur).
  storageKey    String   @unique @map("storage_key") @db.VarChar(300)
  fileName      String   @map("file_name") @db.VarChar(255)
  mimeType      String   @map("mime_type") @db.VarChar(150)
  sizeBytes     BigInt   @map("size_bytes")
  /// Empreinte SHA-256 hexadécimale du contenu.
  sha256        String   @db.Char(64)
  /// Analyse antivirus : PENDING tant que le service d'analyse n'existe pas (S7) ; le téléchargement le signale.
  scanStatus    ScanStatus @default(PENDING) @map("scan_status")
  uploadedBy    String   @map("uploaded_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  document Document @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([documentId, versionNumber])
  @@map("document_versions")
  @@schema("docs")
}

enum AppointmentType {
  FINANCE_DIRECTOR
  DECISION_MAKER
  VISIT

  @@schema("bd")
}

enum AppointmentStatus {
  PLANNED
  HELD
  CANCELLED

  @@schema("bd")
}

/// Rendez-vous ou visite d'une entreprise, dans l'agenda de son organisateur (référence inter-contextes vers iam.users, SANS clé étrangère).
model Appointment {
  id                 String            @id @db.Uuid
  type               AppointmentType
  companyId          String            @map("company_id") @db.Uuid
  contactId          String?           @map("contact_id") @db.Uuid
  offerId            String?           @map("offer_id") @db.Uuid
  /// Opportunité que le rendez-vous sert (facultatif) : un rendez-vous décideur lié ne compte que pour elle (D93).
  opportunityId      String?           @map("opportunity_id") @db.Uuid
  organizerUserId    String            @map("organizer_user_id") @db.Uuid
  startsAt           DateTime          @map("starts_at") @db.Timestamptz(6)
  durationMinutes    Int               @map("duration_minutes")
  location           String?           @db.VarChar(200)
  note               String?           @db.VarChar(500)
  status             AppointmentStatus @default(PLANNED)
  /// Compte rendu (tenu) ou motif d'annulation (annulé) ; absent tant que le rendez-vous est à venir.
  outcomeNote        String?           @map("outcome_note") @db.VarChar(1000)
  closedAt           DateTime?         @map("closed_at") @db.Timestamptz(6)
  postponements      Int               @default(0)
  lastPostponeReason String?           @map("last_postpone_reason") @db.VarChar(500)
  version            Int               @default(1)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  company            Company           @relation(fields: [companyId], references: [id])
  contact            Contact?          @relation(fields: [contactId], references: [id])
  offer              Offer?            @relation(fields: [offerId], references: [id])
  opportunity        Opportunity?      @relation(fields: [opportunityId], references: [id])

  @@index([companyId])
  @@index([startsAt])
  @@index([opportunityId])
  @@map("appointments")
  @@schema("bd")
}

enum OpportunityStage {
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  AGREEMENT_IN_PRINCIPLE
  ACCREDITATION

  @@schema("bd")
}

enum OpportunityStatus {
  OPEN
  WON
  LOST

  @@schema("bd")
}

enum OpportunitySource {
  PROSPECTING
  REFERRAL
  EVENT
  INBOUND
  OTHER

  @@schema("bd")
}

enum LossReason {
  PRICE
  COMPETITOR
  NO_BUDGET
  NO_RESPONSE
  NOT_INTERESTED
  OTHER

  @@schema("bd")
}

/// Opportunité commerciale d'une entreprise. Sa visibilité suit celle de l'entreprise ; jamais supprimée (on la clôt, gagnée ou perdue).
model Opportunity {
  id             String            @id @db.Uuid
  companyId      String            @map("company_id") @db.Uuid
  title          String            @db.VarChar(200)
  amount         Decimal           @db.Decimal(14, 2)
  currency       String            @db.Char(3)
  source         OpportunitySource
  stage          OpportunityStage  @default(QUALIFICATION)
  status         OpportunityStatus @default(OPEN)
  lossReason     LossReason?       @map("loss_reason")
  closingNote    String?           @map("closing_note") @db.VarChar(500)
  closedAt       DateTime?         @map("closed_at") @db.Timestamptz(6)
  /// Dérogation à la règle du rendez-vous décideur : justification et date vont ensemble.
  waiverReason   String?           @map("waiver_reason") @db.VarChar(500)
  waivedAt       DateTime?         @map("waived_at") @db.Timestamptz(6)
  stageChangedAt DateTime          @default(now()) @map("stage_changed_at") @db.Timestamptz(6)
  version        Int               @default(1)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  company        Company           @relation(fields: [companyId], references: [id])
  appointments   Appointment[]
  approvals      Approval[]

  @@index([companyId])
  @@index([status, stage])
  @@map("opportunities")
  @@schema("bd")
}

enum ApprovalStatus {
  REQUESTED
  RECEIVED
  HONORED
  EXPIRED
  CANCELLED

  @@schema("bd")
}

model Approval {
  id            String         @id @db.Uuid
  companyId     String         @map("company_id") @db.Uuid
  opportunityId String         @map("opportunity_id") @db.Uuid
  /// Somme globale couverte ; absente si l'agrément ne couvre qu'un nombre de places (au moins l'un des deux, D1).
  amount        Decimal?       @db.Decimal(14, 2)
  currency      String         @default("XAF") @db.VarChar(3)
  places        Int?
  /// Absente tant que l'agrément est seulement demandé (ou annulé avant réception).
  receivedOn    DateTime?      @map("received_on") @db.Date
  /// Payeur tiers (nom et type vont ensemble) ; absent : le client paie lui-même.
  payerName     String?        @map("payer_name") @db.VarChar(200)
  payerType     ApprovalPayerType? @map("payer_type")
  validUntil    DateTime?      @map("valid_until") @db.Date
  status        ApprovalStatus @default(RECEIVED)
  /// Motif de l'expiration ou de l'annulation ; absent pour un agrément reçu ou honoré.
  closedReason  String?        @map("closed_reason") @db.VarChar(500)
  closedAt      DateTime?      @map("closed_at") @db.Timestamptz(6)
  version       Int            @default(1)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  company       Company        @relation(fields: [companyId], references: [id])
  opportunity   Opportunity    @relation(fields: [opportunityId], references: [id])
  payout        CommissionPayout?

  @@index([companyId])
  @@index([opportunityId])
  @@map("approvals")
  @@schema("bd")
}

enum ApprovalPayerType {
  EMPLOYER
  ORGANISM
  LANDLORD

  @@schema("bd")
}

enum CommissionPayoutStatus {
  DUE
  ON_HOLD
  RELEASED
  PAID
  CANCELLED

  @@schema("bd")
}

enum AmbassadorOrigin {
  CLIENT
  LEARNER

  @@schema("bd")
}

enum AmbassadorStatus {
  ACTIVE
  ARCHIVED

  @@schema("bd")
}

model Ambassador {
  id          String           @id @db.Uuid
  /// Le chargé de compte qui l'a créé (référence inter-contextes vers iam.users, SANS clé étrangère) : détermine la portée des droits.
  ownerUserId String           @map("owner_user_id") @db.Uuid
  lastName    String           @map("last_name") @db.VarChar(100)
  firstName   String           @map("first_name") @db.VarChar(100)
  origin      AmbassadorOrigin
  /// Entreprise d'origine : obligatoire pour un client, facultative pour un apprenant.
  companyId   String?          @map("company_id") @db.Uuid
  email       String?          @db.VarChar(200)
  phone       String?          @db.VarChar(40)
  appointedOn DateTime         @map("appointed_on") @db.Date
  note        String?          @db.VarChar(500)
  /// Archivage réversible (jamais de suppression) : archivé = gelé, retiré des listes courantes, réactivable.
  status        AmbassadorStatus @default(ACTIVE)
  archivedAt    DateTime?        @map("archived_at") @db.Timestamptz(6)
  archiveReason String?          @map("archive_reason") @db.VarChar(500)
  version     Int              @default(1)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  company     Company?         @relation(fields: [companyId], references: [id])

  @@index([ownerUserId])
  @@index([companyId])
  @@index([status])
  @@map("ambassadors")
  @@schema("bd")
}

/// Versement de la commission d'un facilitateur (flux F3) : naît à l'honneur d'un agrément ; montant figé ; déblocage par la Finance, versement avec justificatif.
model CommissionPayout {
  id                 String                 @id @db.Uuid
  companyId          String                 @map("company_id") @db.Uuid
  facilitatorId      String                 @map("facilitator_id") @db.Uuid
  /// Un seul versement par agrément.
  approvalId         String                 @unique @map("approval_id") @db.Uuid
  /// Définition de la commission au moment où elle est devenue due (figée).
  commissionType     CommissionType         @map("commission_type")
  commissionValue    Decimal                @map("commission_value") @db.Decimal(12, 2)
  commissionCurrency String?                @map("commission_currency") @db.Char(3)
  /// Montant à verser ; absent tant qu'un pourcentage n'a pas de montant d'agrément à s'appliquer.
  amount             Decimal?               @db.Decimal(14, 2)
  currency           String                 @db.VarChar(3)
  status             CommissionPayoutStatus @default(DUE)
  holdReason         String?                @map("hold_reason") @db.VarChar(500)
  cancelledReason    String?                @map("cancelled_reason") @db.VarChar(500)
  paidOn             DateTime?              @map("paid_on") @db.Date
  version            Int                    @default(1)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  company            Company                @relation(fields: [companyId], references: [id])
  facilitator        Facilitator            @relation(fields: [facilitatorId], references: [id])
  approval           Approval               @relation(fields: [approvalId], references: [id])

  @@index([companyId])
  @@index([facilitatorId])
  @@index([status])
  @@map("commission_payouts")
  @@schema("bd")
}


// ───────────────────────────── training (S5.1 : catalogue Investudy) ─────────────────────────────

enum CatalogueStatus {
  ACTIVE
  ARCHIVED

  @@schema("training")
}

/// Type de salle : avec postes de travail (salle de marchés) ou salle de cours (places assises, cours magistral).
enum RoomKind {
  WORKSTATIONS
  CLASSROOM

  @@schema("training")
}

/// Programme : regroupement de formations. Référentiel partagé (sans propriétaire) ; archivé, jamais supprimé.
model Program {
  id          String          @id @db.Uuid
  name        String          @db.VarChar(150)
  nameKey     String          @unique @map("name_key") @db.VarChar(150)
  description String?         @db.VarChar(2000)
  audience    String?         @db.VarChar(500)
  status      CatalogueStatus @default(ACTIVE)
  version     Int             @default(1)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  trainings   Training[]

  @@map("programs")
  @@schema("training")
}

/// Certificat (formation vendable et planifiable) : appartient à un seul programme ; objectifs, prérequis (texte libre), prix complet et prix par module (même devise), modules ordonnés.
model Training {
  id            String          @id @db.Uuid
  programId     String          @map("program_id") @db.Uuid
  title         String          @db.VarChar(150)
  titleKey      String          @map("title_key") @db.VarChar(150)
  objectives    String?         @db.VarChar(2000)
  prerequisites String?         @db.VarChar(1000)
  priceAmount   Decimal?        @map("price_amount") @db.Decimal(12, 2)
  modulePriceAmount Decimal?    @map("module_price_amount") @db.Decimal(12, 2)
  priceCurrency String?         @map("price_currency") @db.Char(3)
  status        CatalogueStatus @default(ACTIVE)
  version       Int             @default(1)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  program       Program         @relation(fields: [programId], references: [id])
  modules       TrainingModule[]
  sessions      TrainingSession[]

  @@unique([programId, titleKey])
  @@map("trainings")
  @@schema("training")
}

/// Salle de formation : capacité et équipements ; désactivée (jamais supprimée) pour rester visible sur les sessions passées.
model Room {
  id        String          @id @db.Uuid
  name      String          @db.VarChar(100)
  nameKey   String          @unique @map("name_key") @db.VarChar(100)
  kind      RoomKind        @default(WORKSTATIONS)
  learnerSeats     Int  @map("learner_seats")
  unavailableSeats Int  @default(0) @map("unavailable_seats")
  trainerSeats     Int  @default(1) @map("trainer_seats")
  equipment String?         @db.VarChar(1000)
  status    CatalogueStatus @default(ACTIVE)
  version   Int             @default(1)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions  TrainingSession[]

  @@map("rooms")
  @@schema("training")
}

/// Formateur : interne (compte utilisateur lié, référence SANS clé étrangère) ou externe (sans compte).
model Trainer {
  id          String          @id @db.Uuid
  lastName    String          @map("last_name") @db.VarChar(100)
  firstName   String          @map("first_name") @db.VarChar(100)
  specialties String?         @db.VarChar(500)
  email       String?         @db.VarChar(200)
  emailKey    String?         @unique @map("email_key") @db.VarChar(200)
  phone       String?         @db.VarChar(40)
  userId      String?         @unique @map("user_id") @db.Uuid
  status      CatalogueStatus @default(ACTIVE)
  version     Int             @default(1)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions    TrainingSession[]

  @@map("trainers")
  @@schema("training")
}

/// Module : chapitre partagé entre plusieurs certificats (un titre ; ni durée ni prix, portés par le certificat et le rythme de session).
model CourseModule {
  id          String           @id @db.Uuid
  title       String           @db.VarChar(150)
  titleKey    String           @unique @map("title_key") @db.VarChar(150)
  description String?          @db.VarChar(1000)
  /// Pratique sur poste de travail (ne se donne pas dans une salle de cours) ou cours magistral.
  requiresWorkstations Boolean @default(false) @map("requires_workstations")
  status      CatalogueStatus  @default(ACTIVE)
  version     Int              @default(1)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  trainings   TrainingModule[]

  @@map("modules")
  @@schema("training")
}

/// Place d'un module dans un certificat (ordre 1, 2, 3…).
model TrainingModule {
  trainingId String       @map("training_id") @db.Uuid
  moduleId   String       @map("module_id") @db.Uuid
  position   Int
  training   Training     @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  module     CourseModule @relation(fields: [moduleId], references: [id])

  @@id([trainingId, moduleId])
  @@unique([trainingId, position])
  @@index([moduleId])
  @@map("training_modules")
  @@schema("training")
}

/// État d'une session de formation (S5.2a). « En cours » se déduit des dates ; CLOSED est posé par la clôture (S5.3).
enum SessionStatus {
  PLANNED
  OPEN
  CLOSED
  CANCELLED

  @@schema("training")
}

/// Rythme d'une session : valeurs de référence codées (jour, soir), voir `domain/rhythms.ts`.
enum SessionRhythm {
  DAY
  EVENING

  @@schema("training")
}

/// Session de formation : un certificat, un rythme, une salle, un formateur, des dates (début saisi, fin calculée), une capacité.
/// Jamais supprimée : annulée avec un motif. Pas de propriétaire (référentiel), mais le formateur lié ne voit que les siennes.
model TrainingSession {
  id           String        @id @db.Uuid
  trainingId   String        @map("training_id") @db.Uuid
  roomId       String        @map("room_id") @db.Uuid
  trainerId    String        @map("trainer_id") @db.Uuid
  rhythm       SessionRhythm
  startDate    DateTime      @map("start_date") @db.Date
  endDate      DateTime      @map("end_date") @db.Date
  capacity     Int
  status       SessionStatus @default(PLANNED)
  cancelReason String?       @map("cancel_reason") @db.VarChar(500)
  version      Int           @default(1)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  training Training @relation(fields: [trainingId], references: [id], onDelete: Restrict)
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  trainer  Trainer  @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  enrollments Enrollment[]

  @@index([roomId, startDate, endDate])
  @@index([trainerId, startDate, endDate])
  @@index([trainingId])
  @@index([status, startDate])
  @@map("sessions")
  @@schema("training")
}

/// État d'une inscription (S5.2b) : en attente de confirmation, confirmée, annulée (motif), à replacer (session annulée).
enum EnrollmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  TO_REPLACE

  @@schema("training")
}

/// Apprenant : personne inscrite à une formation pour le compte d'une entreprise (distincte d'un contact, lien facultatif).
/// Suppression logique seulement (`deleted_at`). Suit la portée de son entreprise.
/// Nature d'un apprenant : rattaché à une entreprise (cas général), ou sans entreprise : étudiant ou particulier (Lot B, option C). Les deux derniers n'ont ni entreprise ni contact.
enum LearnerKind {
  COMPANY
  STUDENT
  INDIVIDUAL

  @@schema("training")
}

/// Qui règle les frais d'un apprenant sans entreprise : lui-même, ou un tiers désigné.
enum EnrollmentPayerKind {
  SELF
  THIRD_PARTY

  @@schema("training")
}

/// Nature d'un payeur tiers (apprenant sans entreprise) : les trois types des agréments plus la famille ou un proche.
enum EnrollmentPayerType {
  EMPLOYER
  ORGANISM
  LANDLORD
  FAMILY

  @@schema("training")
}

model Learner {
  id        String    @id @db.Uuid
  /// Absent pour un étudiant ou un particulier (`kind` ≠ COMPANY) : la base garantit la cohérence des deux.
  companyId String?   @map("company_id") @db.Uuid
  kind      LearnerKind @default(COMPANY)
  contactId String?   @map("contact_id") @db.Uuid
  lastName  String    @map("last_name") @db.VarChar(100)
  firstName String    @map("first_name") @db.VarChar(100)
  /// Nom normalisé (minuscules) pour la détection de doublons.
  nameKey   String    @map("name_key") @db.VarChar(210)
  email     String?   @db.VarChar(200)
  emailKey  String?   @map("email_key") @db.VarChar(200)
  phone     String?   @db.VarChar(40)
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  enrollments Enrollment[]

  @@index([companyId])
  @@index([companyId, nameKey])
  @@index([companyId, emailKey])
  @@index([kind, nameKey])
  @@map("learners")
  @@schema("training")
}

/// Inscription d'un apprenant à une session, sous un agrément de son entreprise ou, pour un étudiant ou un particulier (sans entreprise), avec un payeur désigné. Une inscription en attente ou confirmée occupe une place
/// et consomme l'agrément ; annulée ou « à replacer », elle les libère. Jamais supprimée.
model Enrollment {
  id            String           @id @db.Uuid
  sessionId     String           @map("session_id") @db.Uuid
  learnerId     String           @map("learner_id") @db.Uuid
  /// Entreprise de l'apprenant, recopiée : la portée d'une inscription est celle de son entreprise. Absente pour un étudiant ou un particulier.
  companyId     String?          @map("company_id") @db.Uuid
  /// Agrément qui couvre l'inscription (apprenant d'une entreprise). Absent pour un étudiant ou un particulier : le payeur est alors désigné ci-dessous.
  approvalId    String?          @map("approval_id") @db.Uuid
  /// Apprenant sans entreprise : lui-même ou un tiers règle les frais (la base garantit qu'un seul des deux modes existe : agrément ou payeur).
  payerKind     EnrollmentPayerKind? @map("payer_kind")
  payerName     String?          @map("payer_name") @db.VarChar(200)
  payerType     EnrollmentPayerType? @map("payer_type")
  /// Prix complet du certificat au moment de l'inscription, quand l'agrément couvre une somme ; recopié pour que le cumul ne bouge pas si le prix change.
  chargedAmount Decimal?         @map("charged_amount") @db.Decimal(14, 2)
  status        EnrollmentStatus @default(PENDING)
  comment       String?          @db.VarChar(500)
  cancelReason  String?          @map("cancel_reason") @db.VarChar(500)
  confirmedAt   DateTime?        @map("confirmed_at") @db.Timestamptz(6)
  /// Inscription qui a remplacé celle-ci (replacement sur une autre session).
  replacedById  String?          @map("replaced_by_id") @db.Uuid
  version       Int              @default(1)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  session  TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  learner  Learner         @relation(fields: [learnerId], references: [id], onDelete: Restrict)

  @@index([sessionId, status])
  @@index([learnerId, status])
  @@index([approvalId, status])
  @@index([companyId])
  @@map("enrollments")
  @@schema("training")
}

// ───────────── Ressources humaines (RH légère, ADR-0009) : contexte « hr », aucune clé étrangère vers un autre schéma ─────────────

enum EmployeeStatus {
  ACTIVE
  ARCHIVED

  @@schema("hr")
}

/// Employé : identité PROFESSIONNELLE seulement (jamais de salaire, pièce d'identité, adresse personnelle, date de naissance : D57). Distinct du compte (`userId` facultatif, sans clé étrangère).
model Employee {
  id                String         @id @db.Uuid
  /// Matricule de saisie libre, normalisé en majuscules ; unique s'il est renseigné.
  matricule         String?        @db.VarChar(30)
  lastName          String         @map("last_name") @db.VarChar(100)
  firstName         String         @map("first_name") @db.VarChar(100)
  jobTitle          String         @map("job_title") @db.VarChar(150)
  department        String         @db.VarChar(100)
  /// Responsable hiérarchique (donnée RH) ; ne modifie jamais `iam.users.manager_id`.
  managerEmployeeId String?        @map("manager_employee_id") @db.Uuid
  /// Compte de la personne (0 ou 1), référence inter-contextes vers iam.users SANS clé étrangère.
  userId            String?        @map("user_id") @db.Uuid
  workEmail         String?        @map("work_email") @db.VarChar(200)
  workPhone         String?        @map("work_phone") @db.VarChar(40)
  hiredOn           DateTime       @map("hired_on") @db.Date
  leftOn            DateTime?      @map("left_on") @db.Date
  status            EmployeeStatus @default(ACTIVE)
  archivedAt        DateTime?      @map("archived_at") @db.Timestamptz(6)
  archiveReason     String?        @map("archive_reason") @db.VarChar(500)
  version           Int            @default(1)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  manager           Employee?      @relation("EmployeeHierarchy", fields: [managerEmployeeId], references: [id], onDelete: Restrict)
  reports           Employee[]     @relation("EmployeeHierarchy")
  leaveRequests     LeaveRequest[]
  leaveAdjustments  LeaveAdjustment[]
  contracts         Contract[]
  journeys          Journey[]

  @@index([managerEmployeeId])
  @@index([status])
  @@index([department])
  @@map("employees")
  @@schema("hr")
}

/// État d'une demande d'absence (RH-2) : en attente, validée, refusée (motif obligatoire), annulée.
enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@schema("hr")
}

/// Type d'absence PARAMÉTRABLE par la RH (RH-2, D64) : seul un type qui « décompte le solde » consomme les jours de congé annuel. Jamais supprimé : il se désactive.
model LeaveType {
  id                String         @id @db.Uuid
  code              String         @unique @db.VarChar(30)
  label             String         @db.VarChar(100)
  deductsBalance    Boolean        @default(false) @map("deducts_balance")
  requiresApproval  Boolean        @default(true) @map("requires_approval")
  /// Durée maximale d'une demande, en jours (permission exceptionnelle) ; absent = pas de plafond.
  maxDaysPerRequest Decimal?       @map("max_days_per_request") @db.Decimal(5, 2)
  active            Boolean        @default(true)
  sortOrder         Int            @default(0) @map("sort_order")
  version           Int            @default(1)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  requests          LeaveRequest[]

  @@map("leave_types")
  @@schema("hr")
}

/// État d'un contrat (RH-3) : en cours ou terminé. Un seul contrat en cours par employé (index unique partiel dans la migration).
enum ContractStatus {
  ACTIVE
  ENDED

  @@schema("hr")
}

/// Motif de fin : liste fermée, jamais un texte libre.
enum ContractEndReason {
  FIXED_TERM_END
  PROBATION_END
  RESIGNATION
  MISSION_END
  OTHER

  @@schema("hr")
}

/// Type de contrat PARAMÉTRABLE par la RH (RH-3, D67) : `fixedTerm` = date de fin obligatoire. Jamais supprimé : il se désactive.
model ContractType {
  id        String     @id @db.Uuid
  code      String     @unique @db.VarChar(30)
  label     String     @db.VarChar(100)
  fixedTerm Boolean    @default(false) @map("fixed_term")
  active    Boolean    @default(true)
  sortOrder Int        @default(0) @map("sort_order")
  version   Int        @default(1)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  contracts Contract[]

  @@map("contract_types")
  @@schema("hr")
}

/// Contrat d'un employé : AUCUN salaire, document ni donnée sensible. Plusieurs au fil du temps, un seul en cours.
model Contract {
  id               String             @id @db.Uuid
  employeeId       String             @map("employee_id") @db.Uuid
  contractTypeId   String             @map("contract_type_id") @db.Uuid
  startDate        DateTime           @map("start_date") @db.Date
  endDate          DateTime?          @map("end_date") @db.Date
  probationEndDate DateTime?          @map("probation_end_date") @db.Date
  status           ContractStatus     @default(ACTIVE)
  endedOn          DateTime?          @map("ended_on") @db.Date
  endReason        ContractEndReason? @map("end_reason")
  version          Int                @default(1)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  employee         Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  contractType     ContractType       @relation(fields: [contractTypeId], references: [id], onDelete: Restrict)

  @@index([employeeId, startDate])
  @@index([status])
  @@map("contracts")
  @@schema("hr")
}

/// Nature d'un parcours (RH-3b) : intégration d'un nouvel employé ou départ.
enum JourneyKind {
  ONBOARDING
  OFFBOARDING

  @@schema("hr")
}

/// État d'un parcours : en cours, terminé (toutes les tâches cochées) ou annulé. Un seul en cours par employé et par nature (index unique partiel dans la migration).
enum JourneyStatus {
  ACTIVE
  COMPLETED
  CANCELLED

  @@schema("hr")
}

/// Responsable d'une tâche : liste fermée (une étiquette, pas un droit d'accès).
enum JourneyTaskOwner {
  HR
  MANAGER
  EMPLOYEE
  IT

  @@schema("hr")
}

/// Modèle de parcours (RH-3b, D67) : UN par nature, modifiable par la RH. Les tâches lancées sont des copies : modifier le modèle ne change pas les parcours en cours.
model JourneyTemplate {
  id        String                @id @db.Uuid
  kind      JourneyKind           @unique
  version   Int                   @default(1)
  updatedAt DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  tasks     JourneyTemplateTask[]

  @@map("journey_templates")
  @@schema("hr")
}

model JourneyTemplateTask {
  id            String           @id @db.Uuid
  templateId    String           @map("template_id") @db.Uuid
  title         String           @db.VarChar(150)
  owner         JourneyTaskOwner
  /// Jours par rapport à la date de référence (entrée ou départ) ; négatif = avant.
  dueOffsetDays Int              @map("due_offset_days")
  sortOrder     Int              @map("sort_order")
  template      JourneyTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, sortOrder])
  @@map("journey_template_tasks")
  @@schema("hr")
}

/// Parcours lancé à la main pour un employé. Aucune donnée sensible.
model Journey {
  id               String        @id @db.Uuid
  employeeId       String        @map("employee_id") @db.Uuid
  kind             JourneyKind
  referenceDate    DateTime      @map("reference_date") @db.Date
  status           JourneyStatus @default(ACTIVE)
  launchedByUserId String        @map("launched_by_user_id") @db.Uuid
  completedAt      DateTime?     @map("completed_at") @db.Timestamptz(6)
  cancelledAt      DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  version          Int           @default(1)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  employee         Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  tasks            JourneyTask[]

  @@index([employeeId, kind])
  @@index([status])
  @@map("journeys")
  @@schema("hr")
}

model JourneyTask {
  id           String           @id @db.Uuid
  journeyId    String           @map("journey_id") @db.Uuid
  title        String           @db.VarChar(150)
  owner        JourneyTaskOwner
  dueOn        DateTime         @map("due_on") @db.Date
  sortOrder    Int              @map("sort_order")
  doneAt       DateTime?        @map("done_at") @db.Timestamptz(6)
  doneByUserId String?          @map("done_by_user_id") @db.Uuid
  journey      Journey          @relation(fields: [journeyId], references: [id], onDelete: Restrict)

  @@index([journeyId, sortOrder])
  @@map("journey_tasks")
  @@schema("hr")
}

/// Jour férié saisi par la RH (la liste est VIDE au départ : aucune liste légale n'est présumée). Ne compte pas comme jour d'absence.
model PublicHoliday {
  id        String   @id @db.Uuid
  day       DateTime @unique @db.Date
  label     String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("public_holidays")
  @@schema("hr")
}

/// Règles de congés (UNE seule ligne, `id = 1`) : valeurs de départ « à confirmer » (D64), modifiables par la RH avec trace.
model LeaveSettings {
  id                   Int      @id @default(1)
  /// Jours acquis par mois de service.
  accrualDaysPerMonth  Decimal  @default(1.5) @map("accrual_days_per_month") @db.Decimal(4, 2)
  /// Faux : jours ouvrés du lundi au vendredi ; vrai : le samedi compte aussi (jours ouvrables).
  countsSaturday       Boolean  @default(false) @map("counts_saturday")
  allowHalfDays        Boolean  @default(true) @map("allow_half_days")
  allowNegativeBalance Boolean  @default(false) @map("allow_negative_balance")
  version              Int      @default(1)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("leave_settings")
  @@schema("hr")
}

/// Demande d'absence. Dates incluses ; `startHalf` : la première journée commence l'après-midi ; `endHalf` : la dernière journée s'arrête à midi. `days` est figé à la
/// demande (jours fériés et week-ends déjà déduits). Les jours comptent pour l'année de la date de début. Aucune donnée de santé : un motif libre est facultatif.
model LeaveRequest {
  id                String      @id @db.Uuid
  employeeId        String      @map("employee_id") @db.Uuid
  leaveTypeId       String      @map("leave_type_id") @db.Uuid
  startDate         DateTime    @map("start_date") @db.Date
  endDate           DateTime    @map("end_date") @db.Date
  startHalf         Boolean     @default(false) @map("start_half")
  endHalf           Boolean     @default(false) @map("end_half")
  days              Decimal     @db.Decimal(5, 2)
  leaveYear         Int         @map("leave_year")
  status            LeaveStatus @default(PENDING)
  note              String?     @db.VarChar(500)
  /// Compte qui a saisi la demande (l'employé, ou la RH pour lui) : référence inter-contextes SANS clé étrangère.
  requestedByUserId String      @map("requested_by_user_id") @db.Uuid
  decidedByUserId   String?     @map("decided_by_user_id") @db.Uuid
  decidedAt         DateTime?   @map("decided_at") @db.Timestamptz(6)
  decisionNote      String?     @map("decision_note") @db.VarChar(500)
  cancelledAt       DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  cancelReason      String?     @map("cancel_reason") @db.VarChar(500)
  version           Int         @default(1)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  employee          Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType         LeaveType   @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@index([employeeId, startDate])
  @@index([status])
  @@index([leaveYear])
  @@map("leave_requests")
  @@schema("hr")
}

/// Ajustement de solde (report, correction) : AJOUT SEUL, motif obligatoire, jamais modifié ni supprimé.
model LeaveAdjustment {
  id              String   @id @db.Uuid
  employeeId      String   @map("employee_id") @db.Uuid
  year            Int
  days            Decimal  @db.Decimal(5, 2)
  reason          String   @db.VarChar(500)
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, year])
  @@map("leave_adjustments")
  @@schema("hr")
}
