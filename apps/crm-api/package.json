{
  "name": "@investally/crm-api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --testPathIgnorePatterns integration",
    "test:integration": "RUN_DB_TESTS=1 jest --testPathPatterns integration --runInBand",
    "seed:core": "node dist/src/cli/seed-core.js",
    "docs:rbac": "node scripts/gen-rbac-doc.mjs",
    "check:upgrade": "node scripts/check-upgrade.mjs",
    "keys:jwt": "node scripts/generate-jwt-keys.mjs",
    "admin:create": "node dist/src/cli/create-admin.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "^18.0.8",
    "helmet": "8.3.0",
    "jose": "5.10.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "17.10.0-beta.17",
    "jest": "^30.5.2",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node-dev": "^2.0.0",
    "typescript": "5.9.3"
  }
}
