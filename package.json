{
  "name": "investally-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "crm-api": "pnpm --filter @investally/crm-api",
    "crm-web": "pnpm --filter @investally/crm-web",
    "arch": "depcruise apps/crm-api/src --config .dependency-cruiser.cjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "ci": "pnpm typecheck && pnpm arch && pnpm test",
    "local": "node scripts/local-stack.mjs"
  },
  "devDependencies": {
    "dependency-cruiser": "latest"
  }
}
