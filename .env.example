# Copier vers apps/crm-api/.env — ne jamais committer de vrais secrets.

DATABASE_URL="postgresql://investally:CHANGE_ME@localhost:5432/investally?schema=public"
PORT=3001

# development | test | production. En production, l'application REFUSE de démarrer si la configuration
# de sécurité est incomplète (clés, origines) ou dangereuse (cookie non sécurisé).
NODE_ENV=development

# Clés de signature des jetons (ES256, PEM sur une ligne avec \n). Générer avec : pnpm crm-api keys:jwt
# Obligatoires en production. En développement, si absentes : paire éphémère (jetons perdus à chaque redémarrage).
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=

# Origines navigateur autorisées pour les routes d'authentification (défense CSRF). Obligatoire en production.
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Cookie de rafraîchissement « Secure » : vrai par défaut hors développement, interdit de le désactiver en production.
# COOKIE_SECURE=false

# À renseigner quand l'API est derrière le proxy Next.js (l'IP cliente vient de X-Forwarded-For), ex. loopback.
# TRUST_PROXY=loopback

# Clé AES-256 qui chiffre les secrets MFA au repos : 32 octets en base64. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Obligatoire en production. À SAUVEGARDER dans un coffre : la perdre rend tous les secrets MFA inutilisables.
# En développement, si absente : clé éphémère (secrets perdus à chaque redémarrage).
MFA_ENCRYPTION_KEY=

# Fournisseur d'e-mail : log (n'envoie rien, développement et test) ou microsoft365 (obligatoire en production).
EMAIL_PROVIDER=log
# Avec EMAIL_PROVIDER=microsoft365 : application enregistrée dans Entra ID (permission Mail.Send) et boîte d'expédition dédiée.
# M365_TENANT_ID=
# M365_CLIENT_ID=
# M365_CLIENT_SECRET=
# M365_SENDER=crm@votre-domaine.test

# Adresse publique du front (https obligatoire en production) : sert à construire les liens des e-mails d'invitation.
APP_PUBLIC_URL=http://127.0.0.1:3000

# Développement local SEULEMENT : affiche le contenu des e-mails (liens d'invitation) dans la console, car aucun e-mail
# réel ne part avec EMAIL_PROVIDER=log. Interdit en production (l'application refuse de démarrer).
# EMAIL_LOG_CONTENT=true


# S3.6 Documents : dossier des fichiers téléversés (chemin ABSOLU, hors de toute racine web, droits restreints).
# Obligatoire en production ; en développement, un dossier temporaire est utilisé si absent.
# DOCUMENTS_DIR=/var/lib/investally/documents
